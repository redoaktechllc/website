---
import { site } from "@/lib/site";
import { buttonVariants } from "@/components/ui/button";
---

<div
  aria-label="Quick contact"
  class="fixed inset-x-0 bottom-0 z-[60] flex gap-2 border-t border-line-dark bg-char-900/95 p-2.5 backdrop-blur md:hidden"
>
  <a href={site.phoneHref} class={buttonVariants({ variant: "default", size: "xl" }) + " h-[50px] flex-1"}>
    Call us
  </a>
  <a href="/#contact" class={buttonVariants({ variant: "outlineDark", size: "xl" }) + " h-[50px] flex-1 border"}>
    Free preview
  </a>
</div>
