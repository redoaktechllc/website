---
interface Props {
  name: "check" | "minus" | "menu" | "phone" | "mail" | "close";
  class?: string;
}
const { name, class: className = "" } = Astro.props;

const paths: Record<Props["name"], string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  minus: '<path d="M5 12h14"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  phone:
    '<path d="M13.5 2a1.5 1.5 0 0 0 1.5 1.5A4.5 4.5 0 0 1 19.5 8 1.5 1.5 0 0 0 21 9.5M8.4 4.6l1.2 2.7a1.5 1.5 0 0 1-.4 1.8l-1 .8a10 10 0 0 0 4.6 4.6l.8-1a1.5 1.5 0 0 1 1.8-.4l2.7 1.2a1.5 1.5 0 0 1 .9 1.5 3.5 3.5 0 0 1-3.5 3.2A13.5 13.5 0 0 1 4 7 3.5 3.5 0 0 1 7.2 3.5a1.5 1.5 0 0 1 1.2 1.1Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths[name]}
></svg>
