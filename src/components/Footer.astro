---
import Container from "@/components/Container.astro";
import { nav, site } from "@/lib/site";
---

<footer class="bg-char-900 py-12 text-white/75 md:py-14">
  <Container>
    <div class="grid gap-9 md:grid-cols-[2fr_1fr_1fr] md:gap-10">
      <div>
        <a
          href="/"
          aria-label="Red Oak home"
          class="mb-3 inline-flex items-center gap-2.5 font-heading text-[1.2rem] font-extrabold tracking-[-0.02em] text-white"
        >
          <img src="/assets/logo-mark.png" alt="" width="430" height="244" class="h-[26px] w-auto" />
          Red Oak
        </a>
        <p class="max-w-[34ch] text-[0.95rem] text-white/55">
          Fast, modern websites for local businesses across Northeast Ohio. Built to last, and yours
          to keep.
        </p>
      </div>

      <div>
        <h4 class="mb-3 font-heading text-[0.95rem] font-bold text-white">Explore</h4>
        <ul class="grid gap-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-[0.95rem] text-white/70 transition-colors hover:text-brand-300">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-3 font-heading text-[0.95rem] font-bold text-white">Contact</h4>
        <ul class="grid gap-2 text-[0.95rem]">
          <li><a href={site.phoneHref} class="text-white/70 transition-colors hover:text-brand-300">{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`} class="text-white/70 transition-colors hover:text-brand-300">{site.email}</a></li>
          <li class="text-white/70">{site.region}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-line-dark pt-6 text-[0.85rem] text-white/50"
    >
      <span>&copy; 2026 {site.legalName}. All rights reserved.</span>
      <span>Websites for Northeast Ohio.</span>
    </div>
  </Container>
</footer>
