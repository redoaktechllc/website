---
/* Concentric red-oak ring — the recurring brand signature.
   `animate` enables the one deliberate motion moment (hero only). */
interface Props {
  class?: string;
  animate?: boolean;
  tone?: "dark" | "light";
}
const { class: className = "", animate = false, tone = "dark" } = Astro.props;
const stroke = tone === "dark" ? "rgba(242,97,107,0.32)" : "rgba(193,14,43,0.22)";
---

<svg
  class:list={["ringmark", { "ringmark--animate": animate }, className]}
  viewBox="0 0 600 600"
  aria-hidden="true"
  focusable="false"
  style={`--ring-stroke:${stroke}`}
>
  <circle class="r r1" cx="300" cy="300" r="70"></circle>
  <circle class="r r2" cx="300" cy="300" r="128"></circle>
  <circle class="r r3" cx="300" cy="300" r="186"></circle>
  <circle class="r r4" cx="300" cy="300" r="244"></circle>
  <circle class="r r5" cx="300" cy="300" r="300"></circle>
  <circle class="r-core" cx="300" cy="300" r="30"></circle>
</svg>

<style>
  .ringmark { width: 100%; height: auto; display: block; pointer-events: none; }
  .ringmark .r { fill: none; stroke: var(--ring-stroke); stroke-width: 1.5; }
  .ringmark .r-core { fill: #D81E2C; stroke: none; }

  @media (prefers-reduced-motion: no-preference) {
    .ringmark--animate .r {
      stroke-dasharray: 2200;
      stroke-dashoffset: 2200;
      animation: ring-draw 1.6s var(--ease-out, ease) forwards;
    }
    .ringmark--animate .r2 { animation-delay: 0.12s; }
    .ringmark--animate .r3 { animation-delay: 0.24s; }
    .ringmark--animate .r4 { animation-delay: 0.36s; }
    .ringmark--animate .r5 { animation-delay: 0.48s; }
    .ringmark--animate .r-core { opacity: 0; animation: ring-pop 0.5s ease 0.7s forwards; }
  }
  @keyframes ring-draw { to { stroke-dashoffset: 0; } }
  @keyframes ring-pop { to { opacity: 1; } }
</style>
