---
import Container from "@/components/Container.astro";
import SectionHead from "@/components/SectionHead.astro";
import RingMark from "@/components/RingMark.astro";
---

<section id="about" class="scroll-anchor bg-sand py-16 sm:py-20 lg:py-24">
  <Container>
    <SectionHead kicker="Who's behind Red Oak" title="Built in Northeast Ohio" />

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.3fr_0.9fr] lg:items-center lg:gap-14">
      <div>
        <p class="text-lede text-ink">
          Red Oak is a small studio run by Giancarlo Zaccaudelli and Will Ryan. Giancarlo grew up in
          Cleveland, and the two of them started Red Oak in the fall of 2026 to bring local
          businesses online the right way.
        </p>
        <p class="mt-4 text-ink-70">
          Named for the red oak — a tree built to stand for a century — the studio runs on the same
          idea. Your website should be fast, honest, and yours to keep. You see it before you pay,
          you own it after final payment, and you're never locked in.
        </p>
        <p class="mt-4 text-ink-70">
          No agency runaround, no template you've seen on a hundred other sites. Just a site that
          helps your phone ring, and a real person who answers when you need a change.
        </p>
        <span class="mt-6 flex items-center gap-3 border-t border-line pt-5">
          <span class="font-heading text-[1.1rem] font-extrabold text-brand-ink">Giancarlo &amp; Will</span>
          <span class="text-[0.9rem] text-ink-70">Founders, Red Oak LLC</span>
        </span>
      </div>

      <!-- Photo-ready slot: a founder photo can replace this panel later -->
      <figure class="rounded-2xl border border-line bg-white p-8 sm:p-10">
        <RingMark tone="light" class="w-20" />
        <blockquote
          class="mt-6 font-heading text-[clamp(1.45rem,1.1rem+1.5vw,2.05rem)] font-bold leading-[1.14] tracking-[-0.02em] text-brand-ink"
        >
          &ldquo;Your website should be fast, honest, and yours to keep.&rdquo;
        </blockquote>
        <figcaption class="mt-3 text-[0.95rem] text-ink-70">The Red Oak promise</figcaption>
      </figure>
    </div>
  </Container>
</section>
