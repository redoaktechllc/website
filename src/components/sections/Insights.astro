---
import Container from "@/components/Container.astro";
import SectionHead from "@/components/SectionHead.astro";
import { posts } from "@/lib/site";
---

<section id="insights" class="scroll-anchor py-16 sm:py-20 lg:py-24">
  <Container>
    <SectionHead
      kicker="Insights"
      title="Straight answers about getting online"
      sub="Short, practical reads for local business owners. No jargon."
    />

    <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={post.href}
            class="group block border-t border-line pt-5 transition-colors hover:border-brand"
          >
            <span class="font-heading text-[0.82rem] font-bold text-brand-ink">{post.tag}</span>
            <h3 class="mt-2 text-[1.2rem] font-extrabold text-ink">
              <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_2px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_2px]">
                {post.title}
              </span>
            </h3>
            <p class="mt-2 text-[0.96rem] text-ink-70">{post.blurb}</p>
          </a>
        ))
      }
    </div>
  </Container>
</section>
